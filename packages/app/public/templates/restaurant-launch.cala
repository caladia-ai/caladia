          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 70
        },
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 30
        }
      ]
    },
    {
      "id": "inventory",
      "nodeType": "activity",
      "name": "Initial inventory",
      "description": "First produce order, dry goods, bar setup, par levels. Manager places orders, verifies receiving, and sets the daily-prep recipes.",
      "duration": {
        "value": 5,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 1300,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 0
        }
      ],
      "fixedCost": {
        "value": 10000
      }
    },
    {
      "id": "soft-open",
      "nodeType": "activity",
      "name": "Soft open",
      "description": "Limited-capacity friends-and-family service. Real cooking, real tickets, real bills — but with low risk. Manager runs the floor; trainer coaches the team in real time; owner observes and logs friction points.",
      "duration": {
        "value": 3,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 1480,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 60
        },
        {
          "resourceId": "r-owner",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 20
        },
        {
          "resourceId": "r-trainer",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 20
        }
      ]
    },
    {
      "id": "adjust",
      "nodeType": "activity",
      "name": "Adjust on feedback",
      "description": "Tighten menu prices, table layout, prep timing, and service flow based on soft-open feedback. Manager owns the iteration before the public launch.",
      "duration": {
        "value": 3,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 1660,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-manager",
