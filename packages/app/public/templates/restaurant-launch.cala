  "nodes": [
    {
      "id": "start",
      "nodeType": "start",
      "name": "Concept locked",
      "duration": {
        "value": 0,
        "unit": "hours"
      },
      "durationSemantic": "time",
      "position": {
        "x": 40,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": false,
      "resourceAssignments": []
    },
    {
      "id": "site",
      "nodeType": "activity",
      "name": "Site selection",
      "description": "Owner and store manager evaluate locations — foot traffic, demographics, lease terms, competitive density. Owner makes the final call; manager handles on-site walkthroughs and assesses operational fit.",
      "duration": {
        "value": 10,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 200,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-owner",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 60
        },
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 40
        }
      ],
      "distribution": {
        "type": "triangular",
        "min": 5,
        "mode": 10,
        "max": 25
      }
    },
    {
      "id": "lease",
      "nodeType": "activity",
      "name": "Sign lease",
      "description": "Negotiate and execute the lease. Owner reviews terms, runs final negotiations with the landlord, and signs.",
      "duration": {
        "value": 2,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 380,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-owner",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 0
        }
      ],
      "distribution": {
        "type": "triangular",
        "min": 3,
        "mode": 5,
        "max": 12
      }
    },
    {
      "id": "construct",
      "nodeType": "activity",
      "name": "Construction",
      "description": "Build-out of the space — kitchen, dining room, restrooms, MEP. General contractor drives end-to-end; the longest item on the critical path.",
      "duration": {
        "value": 20,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 560,
        "y": 140
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-contractor",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 0
        }
      ],
      "distribution": {
        "type": "triangular",
        "min": 15,
        "mode": 20,
        "max": 35
      },
      "fixedCost": {
        "value": 80000
      }
    },
    {
      "id": "equipment",
      "nodeType": "activity",
      "name": "Equipment install",
      "description": "Install kitchen equipment, POS, refrigeration, ventilation. GC coordinates with equipment vendors; sequenced after major construction is wrapped.",
      "duration": {
        "value": 10,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 560,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-contractor",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 0
        }
      ],
      "distribution": {
        "type": "triangular",
        "min": 7,
        "mode": 10,
        "max": 18
      },
      "fixedCost": {
        "value": 30000
      }
    },
    {
      "id": "signage",
      "nodeType": "activity",
      "name": "Signage & branding",
      "description": "Exterior and interior signage, menu boards, brand-aligned décor. Owner approves the design; GC coordinates installation with the signage vendor. Vendor fee is captured separately as a fixed cost.",
      "duration": {
        "value": 7,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 560,
        "y": 420
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-owner",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 30
        },
        {
          "resourceId": "r-contractor",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 70
        }
      ],
      "fixedCost": {
        "value": 5000
      }
    },
    {
      "id": "permits",
      "nodeType": "decision",
      "name": "Permits & inspection",
      "description": "Health, fire, and occupancy permits + inspections. Manager handles filings; passing all three unlocks the staffing track. Failure routes back to construction punch-list work.",
      "duration": {
        "value": 3,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 760,
        "y": 260
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 0
        }
      ],
      "passProbability": 0.8,
      "failureDelay": {
        "value": 7,
        "unit": "days"
      }
    },
    {
      "id": "hire",
      "nodeType": "activity",
      "name": "Hire staff",
      "description": "Recruit and onboard front-of-house and back-of-house staff. Manager runs hiring; owner approves senior roles (chef, head bartender, GM).",
      "duration": {
        "value": 15,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 940,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 0,
          "share": 80
        },
        {
          "resourceId": "r-owner",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 20
        }
      ],
      "distribution": {
        "type": "triangular",
        "min": 10,
        "mode": 15,
        "max": 25
      }
    },
    {
      "id": "train",
      "nodeType": "activity",
      "name": "Train staff",
      "description": "Service standards, POS, menu knowledge, opening/closing routines. Trainer leads structured sessions; manager handles on-the-floor coaching and reinforces day-to-day expectations.",
      "duration": {
        "value": 10,
        "unit": "days"
      },
      "durationSemantic": "time",
      "position": {
        "x": 1120,
        "y": 280
      },
      "calendarId": null,
      "consumesResources": true,
      "resourceAssignments": [
        {
          "resourceId": "r-trainer",
