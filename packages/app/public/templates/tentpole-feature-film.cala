  "loops": [
    {
      "id": "loop-script-revisions",
      "bodyNodeIds": [
        "dev-revision-pass",
        "dev-notes-review"
      ],
      "kickout": {
        "type": "externalTrigger",
        "description": "Producer + director approve the locked shooting draft."
      },
      "expectedIterations": {
        "type": "triangular",
        "min": 3,
        "mode": 5,
        "max": 8
      },
      "group": "Script revisions",
      "description": "Tentpole script typically goes through 5 revision rounds between first draft and shooting draft; 3–8 is the realistic range."
    },
    {
      "id": "loop-reshoots",
      "bodyNodeIds": [
        "shoot-reshoot-need",
        "shoot-pickup"
      ],
      "kickout": {
        "type": "externalTrigger",
        "description": "Editorial confirms no further pickups needed."
      },
      "expectedIterations": {
        "type": "triangular",
        "min": 1,
        "mode": 2,
        "max": 4
      },
      "group": "Reshoots",
      "description": "1–4 pickup days are normal on a tentpole production. Heavy reshoots (4+) usually signal a recut-pass-test-screening loop kicking in."
    },
    {
      "id": "loop-vfx-rounds",
      "bodyNodeIds": [
        "post-vfx-rev-shot",
        "post-vfx-rev-notes"
      ],
      "kickout": {
        "type": "externalTrigger",
        "description": "Director signs off on final shots."
      },
      "expectedIterations": {
        "type": "triangular",
        "min": 4,
        "mode": 6,
        "max": 12
      },
      "group": "VFX revision rounds",
      "description": "Hero shots commonly go through 8–12 review rounds; minor shots clear in 3–4. The triangular captures the typical spread."
    },
    {
      "id": "loop-trailer-cuts",
      "bodyNodeIds": [
        "mktg-trailer-cut",
        "mktg-trailer-rev"
      ],
      "kickout": {
        "type": "externalTrigger",
        "description": "Marketing + studio sign off on trailer."
      },
      "expectedIterations": {
        "type": "triangular",
        "min": 2,
        "mode": 3,
        "max": 5
      },
      "group": "Trailer review cycle",
      "description": "Teaser → main trailer → final trailer — typically 3 distinct cuts each with notes."
    }
  ],
