          "parallelism": 1,
          "share": 20
        },
        {
          "resourceId": "r-manager",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 40
        },
        {
          "resourceId": "r-partner",
          "count": 1,
          "calendarPolicy": "intersection",
          "parallelism": 1,
          "share": 40
        }
      ]
    },
    {
      "id": "end",
      "nodeType": "end",
      "name": "Engagement closed",
      "duration": {
        "value": 0,
        "unit": "hours"
      },
      "durationSemantic": "time",
      "position": {
        "x": 1520,
        "y": 240
      },
