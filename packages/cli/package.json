{
  "name": "@procsim/cli",
  "version": "0.5.0",
  "type": "module",
  "bin": {
    "caladia": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@procsim/file-format": "workspace:*",
    "@procsim/scheduler": "workspace:*",
    "@procsim/simulation": "workspace:*",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
